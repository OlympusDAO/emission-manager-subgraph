      "brace-expansion@<1.1.13": ">=1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "cross-spawn": ">=7.0.5",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.5",
      "ejs": ">=3.1.10",
      "ejs@<3.1.10": ">=3.1.10",
      "flatted": ">=3.4.2",
      "flatted@<3.4.0": ">=3.4.0",
