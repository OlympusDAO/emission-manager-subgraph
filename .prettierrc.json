{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.ts"],
      "options": {
        "semi": true,
        "singleQuote": false,
        "trailingComma": "es5",
        "printWidth": 100
      }
    },
    {
      "files": ["*.json", "*.jsonc"],
      "options": {
        "semi": false,
        "singleQuote": false,
        "trailingComma": "none",
        "printWidth": 100
      }
    },
    {
      "files": ["*.yaml", "*.yml"],
      "options": {
        "semi": false,
        "singleQuote": true,
        "tabWidth": 2,
        "printWidth": 100,
        "bracketSpacing": true
      }
    },
    {
      "files": ["*.graphql", "*.gql"],
      "options": {
        "semi": false,
        "singleQuote": true,
        "printWidth": 100
      }
    }
  ]
}
